# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Svix signing secret for the Clerk webhook (Clerk Dashboard → Webhooks → your endpoint)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- MongoDB Atlas (M0 free tier) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/advoka?retryWrites=true&w=majority

# --- Supabase Storage (raw document files) ---
# Service role key is server-only — never expose it to the client.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_BUCKET=documents

# --- Inngest (background jobs: document extraction, AI analysis, graph build) ---
# Leave unset for local dev — the Inngest Dev Server auto-discovers
# http://localhost:3000/api/inngest with no keys required.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# --- Added on later build days (LLM providers) ---
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
